# ============================================================
# TokenScan — configuración de secretos (copia a .env y rellena)
# NUNCA subir .env a GitHub. Solo copias este .env.example.
# ============================================================

# --- Telegram ---
# Token del bot: habla con @BotFather en Telegram y crea un bot.
TELEGRAM_BOT_TOKEN=123456789:TU-TOKEN-AQUI
# Tu chat_id personal: escribe a @userinfobot para obtenerlo.
TELEGRAM_CHAT_ID=123456789

# --- LLM (cerebro del agente) ---
# Por defecto usamos B.AI con DeepSeek V4 Flash (modelo rápido y económico,
# API compatible con OpenAI). Cambia base_url y api_key según tu proveedor.
# Vacía por defecto -> el agente usa el fallback determinista (macro_gate).
LLM_API_KEY=
LLM_BASE_URL=https://api.b.ai/v1
LLM_MODEL=deepseek-v4-flash

# --- Exchange real (opcional, solo si TRADING_MODE=live) ---
# Crea API keys SOLO para trading spot, sin retiros, en Binance/Bybit/OKX.
EXCHANGE_NAME=binance
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_TESTNET=false

# --- On-chain / DEX (requiere deps extra) ---
# Cadena activa: base (EVM) | solana
# IMPORTANTE: en mode=live el bot opera real con esta wallet vía Jupiter.
# CHAIN=solana
CHAIN=base
# Endpoint RPC para Solana (solo si CHAIN=solana).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Clave privada de la cartera on-chain (déjala vacía para crear una nueva con /create_wallet).
# ADVERTENCIA: quien tenga esta clave controla los fondos. Solo en el .env del VPS.
WALLET_PRIVATE_KEY=
